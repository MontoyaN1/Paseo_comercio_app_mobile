      rethrow;
    }
  }

  // ========== MÉTODOS DE PARSEO ==========

  /// Parsear lista de plazoletas desde JSON
  List<Plazoleta> _parsePlazoletasFromJson(List<dynamic> jsonList) {
    return jsonList.map((json) => _parsePlazoletaFromJson(json)).toList();
  }

  /// Parsear una plazoleta desde JSON
  Plazoleta _parsePlazoletaFromJson(Map<String, dynamic> json) {
    return Plazoleta(
      id: json['id'] as int,
      nombre: json['nombre'] as String,
      descripcion: json['descripcion'] as String?,
      ubicacion: json['ubicacion'] as String?,
      capacidadMaxima: json['capacidad_maxima'] as int?,
      ordenVisual: json['orden_visual'] as int?,
      activa: json['activa'] as bool,
      fechaCreacion: DateTime.parse(json['fecha_creacion'] as String),
      fechaActualizacion:
          json['fecha_actualizacion'] != null
              ? DateTime.parse(json['fecha_actualizacion'] as String)
              : null,
      metadata: json['metadata'] as Map<String, dynamic>?,
      totalTiendas: (json['total_tiendas'] as int?) ?? 0,
      totalVisitas: (json['total_visitas'] as int?) ?? 0,
      latitud: (json['latitud'] as num?)?.toDouble(),
      longitud: (json['longitud'] as num?)?.toDouble(),
      piso: json['piso'] as String?,
      sector: json['sector'] as String?,
      icono: json['icono'] as String?,
      color: json['color'] as String?,
      tipoUbicacion: _parseTipoUbicacion(json['tipo_ubicacion'] as String?),
      tieneAccesoDiscapacitados:
          json['tiene_acceso_discapacitados'] as bool? ?? false,
      tieneEstacionamiento: json['tiene_estacionamiento'] as bool? ?? false,
      tieneZonaDescanso: json['tiene_zona_descanso'] as bool? ?? false,
      tieneZonaComida: json['tiene_zona_comida'] as bool? ?? false,
      serviciosDisponibles:
          (json['servicios_disponibles'] as List<dynamic>?)
              ?.cast<String>()
              .toList(),
      horarioAcceso: json['horario_acceso'] as String?,
      normasUso: json['normas_uso'] as String?,
    );
  }

  /// Parsear lista de imágenes desde JSON
  List<ImagenBase> _parseImagenesFromJson(List<dynamic> jsonList) {
    return jsonList.map((json) => _parseImagenFromJson(json)).toList();
  }

  /// Parsear una imagen desde JSON
  ImagenBase _parseImagenFromJson(Map<String, dynamic> json) {
    final tipoImagenStr = json['tipo_imagen'] as String? ?? 'principal';
    final tipoImagen = _parseTipoImagen(tipoImagenStr);
    final plazoletaId = json['id_ubicacion'] as int;

    return ImagenPlazoleta(
      id: json['id'] as int,
      urlOriginal: json['url_imagen'] as String,
      urlR2: json['url_r2'] as String?,
      urlS3: json['url_s3'] as String?,
      urlSupabase: json['url_supabase'] as String?,
      nombreArchivo: _extractFileName(json['url_imagen'] as String),
      extension: _extractFileExtension(json['url_imagen'] as String),
      tamanoBytes: (json['tamaño_bytes'] as int?) ?? 0,
      ancho: (json['ancho'] as int?) ?? 0,
      alto: (json['alto'] as int?) ?? 0,
      tipoImagen: tipoImagen,
      esPrincipal: tipoImagen == TipoImagen.principal,
      ordenVisual: (json['orden'] as int?) ?? 0,
      titulo: json['titulo'] as String?,
      descripcion: json['descripcion'] as String?,
      altText: json['alt_text'] as String?,
      metadata: json['metadata'] as Map<String, dynamic>?,
      fechaCreacion: DateTime.parse(json['fecha_subida'] as String),
      fechaActualizacion:
          json['fecha_actualizacion'] != null
              ? DateTime.parse(json['fecha_actualizacion'] as String)
              : null,
      activa: json['activa'] as bool? ?? true,
      hashArchivo: json['hash_archivo'] as String?,
      proveedorPrincipal: json['proveedor_principal'] as String?,
      urlsVariantes: _parseUrlsVariantes(json),
      mimeType: json['mime_type'] as String?,
      optimizada: json['optimizada'] as bool? ?? false,
      calidad: json['calidad'] as int?,
      formatoOptimizado: json['formato_optimizado'] as String?,
      plazoletaId: plazoletaId,
    );
  }

  /// Parsear tipo de ubicación desde string
  TipoUbicacion _parseTipoUbicacion(String? tipoStr) {
    if (tipoStr == null) return TipoUbicacion.plazoleta;

    switch (tipoStr.toLowerCase()) {
      case 'plazoleta':
        return TipoUbicacion.plazoleta;
      case 'pasillo':
        return TipoUbicacion.pasillo;
      case 'entrada':
        return TipoUbicacion.entrada;
      case 'escalera':
        return TipoUbicacion.escalera;
      case 'ascensor':
        return TipoUbicacion.ascensor;
      case 'baño':
        return TipoUbicacion.bano;
      case 'estacionamiento':
        return TipoUbicacion.estacionamiento;
      default:
        return TipoUbicacion.plazoleta;
    }
  }

  /// Parsear tipo de imagen desde string
  TipoImagen _parseTipoImagen(String tipoStr) {
    switch (tipoStr.toLowerCase()) {
      case 'principal':
        return TipoImagen.principal;
      case 'detalle':
        return TipoImagen.detalle;
      case 'plazoleta_productos_fondo':
        return TipoImagen.plazoletaProductosFondo;
      case 'galeria':
        return TipoImagen.galeria;
      case 'icono':
        return TipoImagen.icono;
      case 'banner':
        return TipoImagen.banner;
      case 'thumbnail':
        return TipoImagen.thumbnail;
      default:
        return TipoImagen.principal;
    }
  }

  /// Extraer nombre de archivo desde URL
  String _extractFileName(String url) {
    try {
      final uri = Uri.parse(url);
      final pathSegments = uri.pathSegments;
      return pathSegments.isNotEmpty ? pathSegments.last : 'imagen';
    } catch (e) {
      return 'imagen';
    }
  }

  /// Extraer extensión de archivo desde URL
  String _extractFileExtension(String url) {
    try {
      final fileName = _extractFileName(url);
      final dotIndex = fileName.lastIndexOf('.');
      if (dotIndex != -1 && dotIndex < fileName.length - 1) {
        return fileName.substring(dotIndex + 1).toLowerCase();
      }
      return 'jpg';
    } catch (e) {
      return 'jpg';
    }
  }

  /// Parsear URLs de variantes desde JSON
  Map<String, String>? _parseUrlsVariantes(Map<String, dynamic> json) {
    final variantes = <String, String>{};

    // Agregar URLs de variantes si existen
    if (json['url_thumb'] != null) {
      variantes['thumb'] = json['url_thumb'] as String;
    }
    if (json['url_medium'] != null) {
      variantes['medium'] = json['url_medium'] as String;
    }
    if (json['url_large'] != null) {
      variantes['large'] = json['url_large'] as String;
    }

    // Parsear campo variantes si existe (JSON string)
    if (json['variantes'] != null) {
      try {
        final variantesJson = json['variantes'] as Map<String, dynamic>;
        for (final entry in variantesJson.entries) {
          if (entry.value is Map<String, dynamic>) {
            final variantData = entry.value as Map<String, dynamic>;
            if (variantData['url'] != null) {
              variantes[entry.key] = variantData['url'] as String;
            }
          }
        }
      } catch (e) {
        _logger.w('Error al parsear variantes: $e');
      }
    }

    return variantes.isNotEmpty ? variantes : null;
  }

  // ========== PRODUCTOS RELACIONADOS CON PLAZOLETAS ==========

  @override
  Future<List<Producto>> getProductosPorPlazoleta(
    int plazoletaId, {
    int? page,
    int? limit,
    String? search,
    double? precioMin,
    double? precioMax,
    bool? soloDisponibles,
  }) async {
    try {
      final cacheKey =
          'productos_plazoleta_${plazoletaId}_${search}_${precioMin}_${precioMax}_${soloDisponibles}';

      // Verificar si hay datos en caché
      if (_cacheService.has(cacheKey)) {
        final cachedData = _cacheService.get<List<dynamic>>(cacheKey);
        if (cachedData != null) {
          return cachedData.map((json) => Producto.fromJson(json)).toList();
        }
      }

      // Verificar conectividad
      final hasConnection = await _connectivityService.hasConnection();
      if (!hasConnection) {
        throw NetworkException();
      }

      // Construir query para Supabase
      var query = _supabaseClient
          .from('productos')
          .select('*')
          .eq('plazoleta_id', plazoletaId)
          .order('nombre', ascending: true);

      // Aplicar filtros
      if (search != null && search.isNotEmpty) {
        query = query.ilike('nombre', '%$search%');
      }

      if (precioMin != null) {
        query = query.gte('precio', precioMin);
      }

      if (precioMax != null) {
        query = query.lte('precio', precioMax);
      }

      if (soloDisponibles == true) {
        query = query.eq('disponible', true);
      }

      // Aplicar paginación
      if (page != null && limit != null) {
        final from = (page - 1) * limit;
        final to = from + limit - 1;
        query = query.range(from, to);
      }

      // Ejecutar query
      final response = await query;

      if (response == null || response.isEmpty) {
        return [];
      }

      // Parsear resultados
      final productos =
          response.map((json) => Producto.fromJson(json)).toList();

      // Guardar en caché
      _cacheService.set(
        cacheKey,
        response,
        duration: const Duration(minutes: 10),
      );

      return productos;
    } catch (e, stackTrace) {
      _logger.e(
        'Error en getProductosPorPlazoleta: $e',
        error: e,
        stackTrace: stackTrace,
      );
      rethrow;
    }
  }

