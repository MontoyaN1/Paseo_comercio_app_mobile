// lib/data/repositories/plazoleta_repository.dart

import 'dart:async';
import 'package:logger/logger.dart';

import '../datasources/remote/supabase_client.dart';
import '../datasources/local/local_database.dart';
import '../../domain/repositories/plazoleta_repository_interface.dart';
import '../../domain/entities/plazoleta.dart';
import '../../domain/entities/imagen_base.dart';
import '../../domain/entities/producto.dart';
import '../../domain/entities/tienda.dart';
import '../../domain/entities/enums.dart';
import '../../core/utils/connectivity_service.dart';
import '../../core/utils/cache_service.dart';
import '../../core/errors/app_exceptions.dart';

// Implementaciones simplificadas de métodos no críticos

/// Repositorio para manejar operaciones de plazoletas
class PlazoletaRepository implements PlazoletaRepositoryInterface {
  final SupabaseClientService _supabaseClient;
  final LocalCacheService _localCache;
  final ConnectivityService _connectivityService;
  final CacheService _cacheService;
  final Logger _logger;

  PlazoletaRepository({
    required SupabaseClientService supabaseClient,
    required LocalCacheService localCache,
    required ConnectivityService connectivityService,
    required CacheService cacheService,
  }) : _supabaseClient = supabaseClient,
       _localCache = localCache,
       _connectivityService = connectivityService,
       _cacheService = cacheService,
       _logger = Logger(
         printer: PrettyPrinter(
           methodCount: 0,
           errorMethodCount: 3,
           lineLength: 50,
           colors: true,
           printEmojis: true,
           printTime: false,
         ),
       );

  // ========== OPERACIONES BÁSICAS DE PLAZOLETAS ==========

  @override
  Future<List<Plazoleta>> getPlazoletasActivas({
    int? page,
    int? limit,
    String? search,
    String? piso,
    String? sector,
    bool? tieneZonaComida,
    bool? tieneEstacionamiento,
  }) async {
    try {
      final cacheKey =
          'plazoletas_activas_${search}_${piso}_${sector}_${tieneZonaComida}_${tieneEstacionamiento}';

      // Verificar si hay conexión a internet
      final tieneConexion = await _connectivityService.hasConnection();

      if (!tieneConexion) {
        // Intentar obtener de caché local
        final cachedData = await _localCache.get(cacheKey);
        if (cachedData != null) {
          return _parsePlazoletasFromJson(cachedData);
        }
        throw Exception('No hay conexión a internet');
      }

      // Construir query
      var query = _supabaseClient.client
          .from('plazoletas')
          .select('*')
          .eq('activa', true)
          .order('orden_visual', ascending: true);

      // Aplicar filtros
      if (search != null && search.isNotEmpty) {
        query = query.or('nombre.ilike.%$search%,descripcion.ilike.%$search%');
      }

      if (piso != null) {
        query = query.eq('piso', piso);
      }

      if (sector != null) {
        query = query.eq('sector', sector);
      }

      if (tieneZonaComida != null) {
        query = query.eq('tiene_zona_comida', tieneZonaComida);
      }

      if (tieneEstacionamiento != null) {
        query = query.eq('tiene_estacionamiento', tieneEstacionamiento);
      }

      // Aplicar paginación
      if (page != null && limit != null) {
        final from = (page - 1) * limit;
        query = query.range(from, from + limit - 1);
      }

      final response = await query;

      if (response.error != null) {
        _logger.e('Error al obtener plazoletas activas: ${response.error}');
        throw Exception('Error del servidor: ${response.error!.message}');
      }

      final plazoletas = _parsePlazoletasFromJson(response.data);

      // Guardar en caché
      await _localCache.set(cacheKey, response.data, ttl: Duration(hours: 1));

      return plazoletas;
    } catch (e) {
      _logger.e('Excepción en getPlazoletasActivas: $e');
      rethrow;
    }
  }

  @override
  Future<Plazoleta> getPlazoletaById(int id) async {
    try {
      final cacheKey = 'plazoleta_$id';

      // Verificar si hay conexión a internet
      final tieneConexion = await _connectivityService.hasConnection();

      if (!tieneConexion) {
        // Intentar obtener de caché local
        final cachedData = await _localCache.get(cacheKey);
        if (cachedData != null) {
          return _parsePlazoletaFromJson(cachedData);
        }
        throw Exception('No hay conexión a internet');
      }

      final response =
          await _supabaseClient.client
              .from('plazoletas')
              .select('*')
              .eq('id', id)
              .single();

      if (response.error != null) {
        _logger.e('Error al obtener plazoleta por ID: ${response.error}');
        throw Exception('Error del servidor: ${response.error!.message}');
      }

      final plazoleta = _parsePlazoletaFromJson(response.data);

      // Guardar en caché
      await _localCache.set(cacheKey, response.data, ttl: Duration(hours: 2));

      return plazoleta;
    } catch (e) {
      _logger.e('Excepción en getPlazoletaById: $e');
      rethrow;
    }
  }

  @override
  Future<List<Plazoleta>> getPlazoletasByIds(List<int> ids) async {
    try {
      if (ids.isEmpty) return [];

      final cacheKey = 'plazoletas_ids_${ids.join('_')}';

      // Verificar si hay conexión a internet
      final tieneConexion = await _connectivityService.hasConnection();

      if (!tieneConexion) {
        // Intentar obtener de caché local
        final cachedData = await _localCache.get(cacheKey);
        if (cachedData != null) {
          return _parsePlazoletasFromJson(cachedData);
        }
        throw Exception('No hay conexión a internet');
      }

      final response = await _supabaseClient.client
          .from('plazoletas')
          .select('*')
          .in_('id', ids)
          .order('orden_visual', ascending: true);

      if (response.error != null) {
        _logger.e('Error al obtener plazoletas por IDs: ${response.error}');
        throw Exception('Error del servidor: ${response.error!.message}');
      }

      final plazoletas = _parsePlazoletasFromJson(response.data);

      // Guardar en caché
      await _localCache.set(cacheKey, response.data, ttl: Duration(hours: 1));

      return plazoletas;
    } catch (e) {
      _logger.e('Excepción en getPlazoletasByIds: $e');
      rethrow;
    }
  }

  @override
  Future<List<Plazoleta>> getPlazoletasPopulares({int? limit}) async {
    try {
      final cacheKey = 'plazoletas_populares_$limit';

      // Verificar si hay conexión a internet
      final tieneConexion = await _connectivityService.hasConnection();

      if (!tieneConexion) {
        // Intentar obtener de caché local
        final cachedData = await _localCache.get(cacheKey);
        if (cachedData != null) {
          return _parsePlazoletasFromJson(cachedData);
        }
        throw Exception('No hay conexión a internet');
      }

      var query = _supabaseClient.client
          .from('plazoletas')
          .select('*')
          .eq('activa', true)
          .order('total_visitas', ascending: false);

      if (limit != null) {
        query = query.limit(limit);
      }

      final response = await query;

      if (response.error != null) {
        _logger.e('Error al obtener plazoletas populares: ${response.error}');
        throw Exception('Error del servidor: ${response.error!.message}');
      }

      final plazoletas = _parsePlazoletasFromJson(response.data);

      // Guardar en caché
      await _localCache.set(cacheKey, response.data, ttl: Duration(hours: 1));

      return plazoletas;
    } catch (e) {
      _logger.e('Excepción en getPlazoletasPopulares: $e');
      rethrow;
    }
  }

  @override
  Future<List<Plazoleta>> getPlazoletasDisponibles({
    int? page,
    int? limit,
  }) async {
    try {
      final cacheKey = 'plazoletas_disponibles_${page}_$limit';

      // Verificar si hay conexión a internet
      final tieneConexion = await _connectivityService.hasConnection();

      if (!tieneConexion) {
        // Intentar obtener de caché local
        final cachedData = await _localCache.get(cacheKey);
        if (cachedData != null) {
          return _parsePlazoletasFromJson(cachedData);
        }
        throw Exception('No hay conexión a internet');
      }

      var query = _supabaseClient.client
          .from('plazoletas')
          .select('*')
          .eq('activa', true)
          .lt('total_tiendas', 'capacidad_maxima')
          .order('orden_visual', ascending: true);

      if (page != null && limit != null) {
        final from = (page - 1) * limit;
        query = query.range(from, from + limit - 1);
      }

      final response = await query;

      if (response.error != null) {
        _logger.e('Error al obtener plazoletas disponibles: ${response.error}');
        throw Exception('Error del servidor: ${response.error!.message}');
      }

      final plazoletas = _parsePlazoletasFromJson(response.data);

      // Guardar en caché
      await _localCache.set(cacheKey, response.data, ttl: Duration(hours: 1));

      return plazoletas;
    } catch (e) {
      _logger.e('Excepción en getPlazoletasDisponibles: $e');
      rethrow;
    }
  }

  @override
  Future<List<Plazoleta>> searchPlazoletas(String query) async {
    try {
      final cacheKey = 'plazoletas_search_$query';

      // Verificar si hay conexión a internet
      final tieneConexion = await _connectivityService.hasConnection();

      if (!tieneConexion) {
        // Intentar obtener de caché local
        final cachedData = await _localCache.get(cacheKey);
        if (cachedData != null) {
          return _parsePlazoletasFromJson(cachedData);
        }
        throw Exception('No hay conexión a internet');
      }

      final response = await _supabaseClient.client
          .from('plazoletas')
          .select('*')
          .or(
            'nombre.ilike.%$query%,descripcion.ilike.%$query%,ubicacion.ilike.%$query%',
          )
          .eq('activa', true)
          .order('orden_visual', ascending: true)
          .limit(20);

      if (response.error != null) {
        _logger.e('Error al buscar plazoletas: ${response.error}');
        throw Exception('Error del servidor: ${response.error!.message}');
      }

      final plazoletas = _parsePlazoletasFromJson(response.data);

      // Guardar en caché
      await _localCache.set(
        cacheKey,
        response.data,
        ttl: Duration(minutes: 30),
      );

      return plazoletas;
    } catch (e) {
      _logger.e('Excepción en searchPlazoletas: $e');
      rethrow;
    }
  }

  // ========== IMÁGENES DE PLAZOLETAS ==========

  @override
  Future<List<ImagenBase>> getImagenesPlazoleta(
    int plazoletaId, {
    TipoImagen? tipoImagen,
    bool? soloActivas,
  }) async {
    try {
      final cacheKey =
          'imagenes_plazoleta_${plazoletaId}_${tipoImagen}_${soloActivas}';

      // Verificar si hay conexión a internet
      final tieneConexion = await _connectivityService.hasConnection();

      if (!tieneConexion) {
        // Intentar obtener de caché local
        final cachedData = await _localCache.get(cacheKey);
        if (cachedData != null) {
          return _parseImagenesFromJson(cachedData);
        }
        throw Exception('No hay conexión a internet');
      }

      var query = _supabaseClient.client
          .from('imagen_plazoleta')
          .select('*')
          .eq('id_ubicacion', plazoletaId);

      if (tipoImagen != null) {
        query = query.eq('tipo_imagen', tipoImagen.toString().split('.').last);
      }

      if (soloActivas == true) {
        query = query.eq('activa', true);
      }

      query = query.order('orden', ascending: true);

      final response = await query;

      if (response.error != null) {
        _logger.e('Error al obtener imágenes de plazoleta: ${response.error}');
        throw Exception('Error del servidor: ${response.error!.message}');
      }

      final imagenes = _parseImagenesFromJson(response.data);

      // Guardar en caché
      await _localCache.set(cacheKey, response.data, ttl: Duration(hours: 2));

      return imagenes;
    } catch (e) {
      _logger.e('Excepción en getImagenesPlazoleta: $e');
      rethrow;
    }
  }

  @override
  Future<ImagenBase?> getImagenPrincipalPlazoleta(int plazoletaId) async {
    try {
      final cacheKey = 'imagen_principal_plazoleta_$plazoletaId';

      // Verificar si hay conexión a internet
      final tieneConexion = await _connectivityService.hasConnection();

      if (!tieneConexion) {
        // Intentar obtener de caché local
        final cachedData = await _localCache.get(cacheKey);
        if (cachedData != null) {
          return _parseImagenFromJson(cachedData);
        }
        throw Exception('No hay conexión a internet');
      }

      final response =
          await _supabaseClient.client
              .from('imagen_plazoleta')
              .select('*')
              .eq('id_ubicacion', plazoletaId)
              .eq('tipo_imagen', 'principal')
              .eq('activa', true)
              .order('orden', ascending: true)
              .limit(1)
              .single();

      if (response.error != null) {
        // Si no se encuentra imagen principal, no es un error
        if (response.error!.message.contains('No rows found')) {
          return null;
        }
        _logger.e(
          'Error al obtener imagen principal de plazoleta: ${response.error}',
        );
        throw Exception('Error del servidor: ${response.error!.message}');
      }

      final imagen = _parseImagenFromJson(response.data);

      // Guardar en caché
      await _localCache.set(cacheKey, response.data, ttl: Duration(hours: 2));

      return imagen;
    } catch (e) {
      _logger.e('Excepción en getImagenPrincipalPlazoleta: $e');
      return null;
    }
  }

