# ⚙️ CONFIGURACIÓN DE LA APLICACIÓN (OPCIONAL)
# ============================================

APP_NAME=Paseo del Comercio
DEBUG_MODE=false
ENABLE_LOGGING=true
ENABLE_ANALYTICS=true
CACHE_TTL_HOURS=1
MAX_CACHE_SIZE_MB=100

# Soporte
